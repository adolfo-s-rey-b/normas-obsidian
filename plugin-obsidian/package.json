{
  "name": "obsidian-normas-colombianas",
  "version": "0.1.0",
  "description": "Plugin de Obsidian para descargar normativa colombiana desde la biblioteca central del repositorio.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": ["obsidian", "plugin", "colombia", "normativa", "leyes"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.0",
    "obsidian": "latest",
    "typescript": "^5.4.0"
  }
}
