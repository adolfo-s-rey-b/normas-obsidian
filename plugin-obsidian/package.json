{
  "name": "obsidian-normas-colombianas",
  "version": "0.3.0",
  "description": "Plugin de Obsidian para descargar normativa colombiana desde la biblioteca central del repositorio.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add ../manifest.json ../versions.json",
    "test": "esbuild main.ts --bundle --platform=node --format=cjs --outfile=test/.main-test.js --external:obsidian --log-level=warning && NODE_PATH=test/mock node test/prueba.js"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "colombia",
    "normativa",
    "leyes"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.21.5",
    "obsidian": "1.14.4",
    "typescript": "5.9.3"
  },
  "author": "adolfo-s-rey-b",
  "repository": {
    "type": "git",
    "url": "https://github.com/adolfo-s-rey-b/normas-obsidian.git"
  }
}
